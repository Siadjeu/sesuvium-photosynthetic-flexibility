#!/usr/bin/env bash
#SBATCH --job-name=remaining_report
#SBATCH --partition=all_cpu.p
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --output=remaining_report_%j.out
#SBATCH --error=remaining_report_%j.err
set -euo pipefail
: "${PROJECT_ROOT:?Export PROJECT_ROOT before submission}"
command -v python3
python3 - <<'PY'
import urllib.request,time,csv,gzip,hashlib,json,os,re,shutil,subprocess,tarfile
from pathlib import Path
from collections import Counter,defaultdict
from datetime import datetime,timezone
root=Path(os.environ['PROJECT_ROOT']).resolve(strict=True);base=root/'08_focused_families/validation'
def need(v,msg):
 if not v:raise SystemExit(msg)
def sha(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 return h.hexdigest()
def verify(p):
 for line in (p/'SHA256SUMS.txt').read_text().splitlines():
  h,n=line.split(maxsplit=1);f=(p/n.lstrip('*')).resolve()
  need(f.is_relative_to(p) and f.is_file() and sha(f)==h,'Checksum mismatch: '+n)
def read(p):
 with p.open() as f:return list(csv.DictReader(f,delimiter='\t'))
def fasta(p):
 d={};headers={};key=None
 with p.open() as f:
  for line in f:
   if line.startswith('>'):
    key=line[1:].split()[0];need(key not in d,'Duplicate FASTA ID '+key);d[key]='';headers[key]=line[1:].strip()
   elif line.strip():
    need(key is not None,'Invalid FASTA');d[key]+=''.join(line.split()).upper()
 return d,headers
def norm(s):return s[:-1] if s.endswith('*') else s
def valid(s):return bool(s) and set(s)<=set('ACDEFGHIKLMNPQRSTVWYBXZJUO') and not set(s)<=set('ACGTN')
def release(step,env):
 pp=[root/os.environ[env]] if os.environ.get(env) else [p for p in (base/step).glob('release_*') if p.is_dir() and (p/'QC.json').is_file()]
 need(len(pp)==1,'Set '+env+' to the intended release');p=pp[0].resolve(strict=True);verify(p);return p













src=release('step25kz17.73','REMAINING_LEDGER_RELEASE')
out=base/'step25kz17.74'/('release_'+os.environ.get('SLURM_JOB_ID','local')+'_'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'));out.mkdir(parents=True,exist_ok=False)
def table(name,rows,fields):
 with (out/name).open('w',newline='') as f:
  w=csv.DictWriter(f,fields,delimiter='\t',lineterminator='\n');w.writeheader();w.writerows(rows)
ledger=read(src/'01_integrated_locus_evidence.tsv');coverage=read(src/'08_refreshed_family_coverage.tsv');decisions=read(src/'03_protein_decisions.tsv');domains=read(src/'prior_09_combined_domain_review.tsv')
families=[r['wang_family'] for r in coverage];species=['AT','BV','MC','PO','SLP_Hap1','SP_Hex','SP_Tet','SS'];tiers=['SUPPORTED','MODEL_CAVEAT','LIMITED_PANEL_CAVEAT','PARTIAL','UNRESOLVED','OUTSIDE_FAMILY_SET','EXCLUDED']
need(len(families)==23 and len(set(families))==23,'Unexpected Wang family coverage');need({r['count_tier'] for r in ledger}<=set(tiers),'Unknown evidence tier');need({r['species'] for r in ledger}<=set(species),'Unexpected species')
keys=[(r['wang_family'],r['species'],r['gene_id']) for r in ledger];need(len(keys)==len(set(keys)),'Duplicate family/species/locus keys: stop before counting');need(all(r['gene_id'] and not r['gene_id'].startswith('UNMAPPED:') for r in ledger),'Unmapped locus key: stop before reporting locus counts')
integrated={r['wang_family'] for r in ledger};counts=Counter((r['wang_family'],r['species'],r['count_tier']) for r in ledger)
shutil.copyfile(src/'01_integrated_locus_evidence.tsv',out/'01_integrated_locus_evidence.tsv')
long=[]
for fam in families:
 for sp in species:
  ready=fam in integrated
  row=dict(wang_family=fam,species=sp,evidence_available=ready,**{t:counts[(fam,sp,t)] if ready else 'NA' for t in tiers},formal_Wang_count='NA',interpretation='EVIDENCE_COUNTS_NOT_EXHAUSTIVE_FAMILY_COUNTS' if ready else 'NO_VALIDATED_FAMILY_LEDGER')
  long.append(row)
table('02_species_family_evidence.tsv',long,list(long[0]))
for tier in tiers:
 matrix=[dict(wang_family=fam,**{sp:counts[(fam,sp,tier)] if fam in integrated else 'NA' for sp in species}) for fam in families];table('matrix_'+tier+'.tsv',matrix,['wang_family']+species)
# Compact text cells preserve category distinctions; do not sum uncertain tiers into formal totals.
compact=[]
for fam in families:
 compact.append(dict(wang_family=fam,**{sp:(' / '.join(str(counts[(fam,sp,t)]) for t in tiers[:5]) if fam in integrated else 'NA') for sp in species}))
table('03_compact_evidence_matrix.tsv',compact,['wang_family']+species)
# Review exactly the80-member ASPAT edge already flagged; no support threshold change.
edge=[r for r in read(src/'02_reference_edge_associations.tsv') if r['edge_id']=='Aminotransferase_ASPAT_1'];need(len(edge)==1 and edge[0]['support_category']=='SUPPORT_LIMITED_ASSOCIATION','ASPAT edge differs from reviewed input')
review=[r for r in decisions if r['wang_family']=='ASPAT' and 'Aminotransferase_ASPAT_1' in r['edge_ids'].split(';')];need(len(review)==int(edge[0]['candidate_proteins'])==80,'ASPAT target set changed')
dm={(r['wang_family'],r['protein_id']):r for r in domains};members=read(src/'prior_01_all_membership.tsv');mm={r['original_id']:r for r in members if r['group']=='Aminotransferase' and r['kind']=='CANDIDATE'}
aln,_=fasta(src/'Aminotransferase/03_main_core.faa');audit=[]
for r in review:
 k=r['protein_id'];dr=dm[('ASPAT',k)];m=mm[k];seq=aln[m['tip_id']];need(r['count_tier']=='UNRESOLVED','Unexpected promoted ASPAT record')
 clean=m['architecture_flags']=='NONE'
 audit.append(dict(protein_id=k,species=r['species'],gene_id=r['gene_id'],best_positive=dr['best_positive'],best_comparator=dr['best_comparator'],similarity_category=dr['similarity_category'],Pfam_models=dr['Pfam_models'],domain_review_flags=dr['review_flags'],architecture_flags=m['architecture_flags'],alignment_non_gap_fraction=round(sum(c!='-' for c in seq)/len(seq),6),SH_aLRT=edge[0]['SH_aLRT'],UFBoot=edge[0]['UFBoot'],bounded_review_category='REFERENCE_ASSOCIATED_SUPPORT_LIMITED' if clean else 'REFERENCE_ASSOCIATED_SUPPORT_AND_ARCHITECTURE_LIMITED',ledger_decision='RETAIN_UNRESOLVED',next_action='REPORT_LIMITATION_NO_AUTOMATIC_TREE_RERUN'))
table('04_ASPAT80_bounded_review.tsv',audit,list(audit[0]));asp_summary=Counter((r['species'],r['bounded_review_category']) for r in audit);table('05_ASPAT80_species_summary.tsv',[dict(species=sp,category=c,loci=n) for (sp,c),n in sorted(asp_summary.items())],['species','category','loci'])

wang=[{'wang_species': 'P. oleracea', 'wang_family': 'beta-CA', 'published_count': 11, 'source_sheet': 'Table S6', 'source_cell': 'B3'}, {'wang_species': 'P. oleracea', 'wang_family': 'PEPC', 'published_count': 13, 'source_sheet': 'Table S6', 'source_cell': 'C3'}, {'wang_species': 'P. oleracea', 'wang_family': 'PPCK', 'published_count': 3, 'source_sheet': 'Table S6', 'source_cell': 'D3'}, {'wang_species': 'P. oleracea', 'wang_family': 'NAD-ME', 'published_count': 7, 'source_sheet': 'Table S6', 'source_cell': 'E3'}, {'wang_species': 'P. oleracea', 'wang_family': 'NADP-ME', 'published_count': 15, 'source_sheet': 'Table S6', 'source_cell': 'F3'}, {'wang_species': 'P. oleracea', 'wang_family': 'MDH', 'published_count': 18, 'source_sheet': 'Table S6', 'source_cell': 'G3'}, {'wang_species': 'P. oleracea', 'wang_family': 'ASPAT', 'published_count': 11, 'source_sheet': 'Table S6', 'source_cell': 'H3'}, {'wang_species': 'P. oleracea', 'wang_family': 'AlaAT', 'published_count': 5, 'source_sheet': 'Table S6', 'source_cell': 'I3'}, {'wang_species': 'P. oleracea', 'wang_family': 'PEPCK', 'published_count': 2, 'source_sheet': 'Table S6', 'source_cell': 'J3'}, {'wang_species': 'P. oleracea', 'wang_family': 'PPDK', 'published_count': 8, 'source_sheet': 'Table S6', 'source_cell': 'K3'}, {'wang_species': 'P. oleracea', 'wang_family': 'PPDK-RE', 'published_count': 4, 'source_sheet': 'Table S6', 'source_cell': 'L3'}, {'wang_species': 'P. oleracea', 'wang_family': 'BASS2', 'published_count': 1, 'source_sheet': 'Table S6', 'source_cell': 'M3'}, {'wang_species': 'P. oleracea', 'wang_family': 'MEP', 'published_count': 7, 'source_sheet': 'Table S6', 'source_cell': 'N3'}, {'wang_species': 'P. oleracea', 'wang_family': 'DIT2', 'published_count': 4, 'source_sheet': 'Table S6', 'source_cell': 'O3'}, {'wang_species': 'P. oleracea', 'wang_family': 'DIC', 'published_count': 4, 'source_sheet': 'Table S6', 'source_cell': 'P3'}, {'wang_species': 'P. oleracea', 'wang_family': 'DTC', 'published_count':