sourceinfo=[{'source': 'Wang supplementary workbook', 'sha256': 'be4bd29d0932d396be47734cf9bcfc4588352709b11f64edd92e815a3bcfc423', 'location': 'Table S6', 'doi': '10.1093/plphys/kiad451'}, {'source': 'Wang supplementary information PDF', 'sha256': 'abcf1aa85553a279ada3aeb836681f25389f339262cf7750a456b48b193528e3', 'location': 'PDF page8, Supplemental Figure S9 legend', 'doi': '10.1093/plphys/kiad451'}]

table('06_Wang_S6_published_counts.tsv',wang,['wang_species','wang_family','published_count','source_sheet','source_cell']);table('06_source_document_provenance.tsv',sourceinfo,['source','sha256','location','doi'])
definitions=[dict(wang_family='MEP',status='LABEL_RESOLVED_REFERENCE_SCOPE_UNRESOLVED',source='Wang Supplemental Figure S9 legend, PDF page8',finding='Proton:pyruvate cotransporter label paired with BASS2 sodium:pyruvate transport in legend',unresolved='Exact genes/reference sequences underlying TableS6 not established; not the methylerythritol phosphate pathway or an ammonium MEP family',required_evidence='Original Wang MEP identifiers or explicit cited reference panel',count='NA'),dict(wang_family='PPA',status='WANG_SCOPE_UNRESOLVED',source='Wang TableS6; supplied supplementary PDF and workbook',finding='TableS6 contains PPA as a separate column from V_Ppase; the inspected supplementary text does not define its exact gene scope',unresolved='Do not equate an abbreviation or similar numerical count with a molecular family',required_evidence='Original Wang PPA identifiers or an explicit family definition and reference panel',count='NA')]
table('07_remaining_definition_decisions.tsv',definitions,list(definitions[0]))
# Only actual species overlaps; AT is Amaranthus tricolor, never Arabidopsis.
spmap={'BV':'B. vulgaris','PO':'P. oleracea'};fammap={'V_ATPase':'V_ATpase','V_Ppase':'V_Ppase'}
# Resolve family spellings by punctuation/case normalization, not fuzzy biological matching.
def label(s):return re.sub(r'[^a-z0-9]','',s.lower())
wf={label(r['wang_family']):r['wang_family'] for r in wang};wi={(r['wang_species'],label(r['wang_family'])):r for r in wang};comparison=[]
for fam in families:
 for sp,ws in spmap.items():
  wr=wi.get((ws,label(fam)));need(wr is not None,'Missing exact normalized S6 family '+fam)
  comparison.append(dict(wang_family=fam,species=sp,wang_species=ws,published_S6_count=wr['published_count'],current_supported_evidence=counts[(fam,sp,'SUPPORTED')] if fam in integrated else 'NA',current_model_caveat=counts[(fam,sp,'MODEL_CAVEAT')] if fam in integrated else 'NA',current_limited_panel_caveat=counts[(fam,sp,'LIMITED_PANEL_CAVEAT')] if fam in integrated else 'NA',comparison_status='CONTEXT_ONLY_DIFFERENT_ANNOTATIONS_AND_UNCONFIRMED_COUNT_SCOPE',source_cell=wr['source_cell']))
table('09_Wang_context_comparison.tsv',comparison,list(comparison[0]))
for r in coverage:
 if r['wang_family'] in integrated:r.update(current_status='EVIDENCE_REPORT_PREPARED_WITH_EXPLICIT_LIMITATIONS',next_action='RETAIN_CURRENT_CATEGORIES;NO_AUTOMATIC_RERUN')
 if r['wang_family']=='ASPAT':r.update(next_action='80_LOCUS_SUPPORT_LIMITATION_REVIEW_CLOSED_WITH_UNRESOLVED_STATUS')
 if r['wang_family']=='MEP':r.update(current_status='LABEL_RESOLVED_REFERENCE_SCOPE_UNRESOLVED',next_action='OBTAIN_ORIGINAL_COUNTED_IDENTIFIERS_OR_REFERENCE_PANEL')
 if r['wang_family']=='PPA':r.update(current_status='WANG_SCOPE_UNRESOLVED',next_action='OBTAIN_ORIGINAL_COUNTED_IDENTIFIERS_OR_EXPLICIT_DEFINITION')
table('08_refreshed_family_coverage.tsv',coverage,list(coverage[0]))
# Generate all23x8 formal slots as explicitly unavailable, rather than silently treating them as zero.
table('10_formal_Wang_counts_PENDING.tsv',[dict(wang_family=f,**{sp:'NA' for sp in species}) for f in families],['wang_family']+species)
summary=[dict(wang_family=f,**{t:sum(counts[(f,sp,t)] for sp in species) if f in integrated else 'NA' for t in tiers},formal_count='NA') for f in families];table('11_family_evidence_summary.tsv',summary,list(summary[0]))
report=['# Photosynthesis-family evidence report','', 'This report summarizes locus-level evidence categories. It is not an exhaustive count of C4/CAM-functional genes or an exact reproduction of Wang TableS6.','', '## Counting convention','', 'Each family/species/locus key appears once. Supported, model-caveat, limited-panel, partial and unresolved categories remain separate. Outside-family-set and excluded records are provided separately. Zero means no records in that evidence category; it does not establish genomic absence. NA means the family lacks an integrated ledger. The compact matrix cell order is supported / model caveat / limited-panel caveat / partial / unresolved. Do not sum across families: shared screening pools and possible multifunctionality make such totals non-unique.','', '## Closed bounded ASPAT review','', 'All80 candidates retain unresolved status because the shared reference-associated edge has91.6SH-aLRT/74UFBoot support. '+str(sum(x['bounded_review_category']=='REFERENCE_ASSOCIATED_SUPPORT_LIMITED' for x in audit))+' have no architecture flags in the prior main-core review; '+str(sum(x['bounded_review_category']!='REFERENCE_ASSOCIATED_SUPPORT_LIMITED' for x in audit))+' retain architecture flags. Domain compatibility and similarity do not override the support limitation. No new tree or relaxed support threshold was used.','', '## Remaining definition gaps','', 'MEP is labelled as a proton:pyruvate cotransporter in the Wang FigureS9 legend. Exact counted gene membership and reference sequences are still unavailable. PPA appears separately from V_Ppase in TableS6, but its exact scope remains unverified. Neither receives a numerical count.','', '## Published comparison','', 'The source workbook TableS6 is embedded with cell-level provenance. Only BV/B. vulgaris and PO/P. oleracea are matched for context. Project AT is A. tricolor, not A. thaliana. SLP_Hap1 is not matched to H. undatus. Differences in annotation, input genome and counting definition preclude interpreting numerical differences as expansions or losses.','', '## Stopping rule','', 'Do not rerun completed screens, domains or trees solely to change support. Retain partial/annotation limitations without unsupported gene repair. The remaining source requirement is the MEP/PPA counted-ID lists or explicit reference definitions. All formal count slots remain NA until final scope and reporting decisions are resolved.']
(out/'REPORT.md').write_text('\n'.join(report)+'\n')
for n in ['02_reference_edge_associations.tsv','03_protein_decisions.tsv']:shutil.copyfile(src/n,out/('source_'+n))
(out/'PROVENANCE.json').write_text(json.dumps(dict(step73_manifest_sha256=sha(src/'SHA256SUMS.txt'),source_ledger_sha256=sha(src/'01_integrated_locus_evidence.tsv'),source_documents=sourceinfo,upstream=json.loads((src/'PROVENANCE.json').read_text())),indent=2)+'\n')
need(sha(src/'01_integrated_locus_evidence.tsv')==sha(out/'01_integrated_locus_evidence.tsv'),'Ledger changed')
qc=dict(status='EVIDENCE_REPORT_AND_BOUNDED_REVIEW_COMPLETE',integrated_records=len(ledger),integrated_families=len(integrated),report_families=len(families),species=len(species),matrix_cells=len(families)*len(species),ASPat_support_limited_loci=len(audit),ASPat_architecture_flags=sum(r['architecture_flags']!='NONE' for r in audit),Wang_source_values=len(wang),ledger_unchanged=True,new_searches=0,new_trees=0,formal_counts=False,definition_gaps=['MEP_REFERENCE_MEMBERSHIP','PPA_EXACT_SCOPE'])
(out/'QC.json').write_text(json.dumps(qc,indent=2)+'\n');files=sorted(p for p in out.rglob('*') if p.is_file());(out/'SHA256SUMS.txt').write_text(''.join(sha(p)+'  '+str(p.relative_to(out))+'\n' for p in files));verify(out)
bundle=out.with_name(out.name+'_bundle.tar.gz')
with tarfile.open(bundle,'w:gz') as t:
 for p in files+[out/'SHA256SUMS.txt']:t.add(p,arcname='Wang_evidence_reporting_closure/'+str(p.relative_to(out)))
print(json.dumps(qc,indent=2));print('BUNDLE='+str(bundle))
